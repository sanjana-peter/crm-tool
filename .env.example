# Copy to .env.local and fill in. Placeholders only — NEVER commit real values.
# `npm run db:start` prints the local Supabase URL and keys for development.

# ---------------------------------------------------------------------------
# Supabase (Postgres + Auth)
# ---------------------------------------------------------------------------
# Public — inlined into the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_. Bypasses Row Level Security, so
# it is used only for org bootstrap, webhooks, credential storage, rate limiting
# and auth-admin calls (see docs/security.md).
SUPABASE_SERVICE_ROLE_KEY=

# The app's public origin (OAuth redirect URIs, webhook URLs, password-reset
# links). On Vercel it's inferred if unset; set it for a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Credential encryption (REQUIRED in production)
# ---------------------------------------------------------------------------
# AES-256-GCM key for integration tokens stored in the database. 32 random
# bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes stored Meta/WhatsApp/Google credentials unreadable (admins
# reconnect); rotating it needs a re-encrypt step (see docs/security.md).
INTEGRATION_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Mock providers ("Demo mode")
# ---------------------------------------------------------------------------
# With no provider credentials the app runs mock WhatsApp / Calendar / lead
# adapters so everything can be evaluated. ON by default outside production;
# OFF in production unless set to true. Never enable on a deployment real
# customers use: a mock "sends" WhatsApp messages that are not delivered.
ENABLE_MOCK_PROVIDERS=
# Signs deliveries to the credential-free test lead source
# (POST /api/webhooks/mock-lead and the mock WhatsApp inbound). Defaults to a
# dev-only value outside production; REQUIRED if you enable mocks in production.
MOCK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Meta (Facebook/Instagram) Lead Ads + WhatsApp Cloud API
# One Meta app serves both. Server-only — the app secret signs webhooks.
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
# Any random string you choose; paste the same value into the Meta app's
# webhook "Verify Token" (for both the Ads and the WhatsApp callback URLs).
META_WEBHOOK_VERIFY_TOKEN=
# Optional — pin to the Graph API version your app targets.
META_GRAPH_VERSION=v23.0

# ---------------------------------------------------------------------------
# Instagram DMs (Instagram API with Instagram Login)
# Meta app → add the Instagram product → "API setup with Instagram login".
# It has its OWN app id/secret (not META_APP_ID). Redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/integrations/instagram/callback
# Webhook callback: <NEXT_PUBLIC_APP_URL>/api/webhooks/instagram
# (fields: messages, messaging_seen; verify token = META_WEBHOOK_VERIFY_TOKEN
# unless INSTAGRAM_WEBHOOK_VERIFY_TOKEN is set).
# ---------------------------------------------------------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Vercel Cron sends it as a Bearer token to /api/cron/instagram-token-refresh,
# which renews Instagram access daily. Any long random string.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Google Calendar / Meet
# OAuth client (type: Web application) from Google Cloud Console with the
# Calendar API enabled. Authorized redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/integrations/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Calendly (optional fallback booking link, per-org override lives in Settings)
# ---------------------------------------------------------------------------
CALENDLY_BOOKING_URL=

# ---------------------------------------------------------------------------
# Access control and abuse protection
# ---------------------------------------------------------------------------
# Set to false to close public organization sign-up (design-partner pilots):
# invitations keep working. Default: open.
SIGNUP_ENABLED=true
# Rate-limit ceilings (defaults shown). Raise only for automated test servers.
# LOGIN_RATE_LIMIT_PER_IP=30          # per 10 min
# LOGIN_RATE_LIMIT_PER_EMAIL=10       # per 10 min, per account
# SIGNUP_RATE_LIMIT_PER_IP=5          # per hour
# RESET_RATE_LIMIT_PER_IP=10          # per hour
# RESET_RATE_LIMIT_PER_EMAIL=3        # per hour

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error  (structured JSON on stdout; secrets are redacted)
LOG_LEVEL=info
